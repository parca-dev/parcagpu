# Writes parcagpu_version.h. Run with cmake -P on every build (the
# parcagpu_version target), so the version follows commits and edits without a
# reconfigure. The header is rewritten only when its contents change, so an
# unchanged tree recompiles nothing.
#
# Inputs (-D):
#   SOURCE_DIR   the parcagpu checkout
#   OUTPUT       the header to write
#   BUILD_TYPE   CMAKE_BUILD_TYPE
#   CUDA_INCLUDE_DIR  where cuda.h and cupti_version.h are (a list is fine)
#   PARCAGPU_VERSION, PARCAGPU_GIT_SHA, PARCAGPU_GIT_DIRTY
#                overrides, for builds without .git (Docker); empty means ask
#                git. Without git and without an override: "unknown", and
#                dirty is "unknown" too.

function(git_out var)
    execute_process(
        COMMAND git ${ARGN}
        WORKING_DIRECTORY "${SOURCE_DIR}"
        OUTPUT_VARIABLE out
        OUTPUT_STRIP_TRAILING_WHITESPACE
        RESULT_VARIABLE rc
        ERROR_QUIET
    )
    if(rc EQUAL 0)
        set(${var} "${out}" PARENT_SCOPE)
    else()
        set(${var} "" PARENT_SCOPE)
    endif()
endfunction()

set(version "${PARCAGPU_VERSION}")
set(sha "${PARCAGPU_GIT_SHA}")
set(dirty "${PARCAGPU_GIT_DIRTY}")

if(version STREQUAL "" OR sha STREQUAL "" OR dirty STREQUAL "")
    find_program(GIT git)
    if(GIT)
        # Refreshes the index first, so a touched but unchanged file isn't
        # counted as dirty. Untracked files don't count.
        git_out(describe describe --always --dirty --tags)
        git_out(head rev-parse HEAD)
        if(version STREQUAL "")
            set(version "${describe}")
        endif()
        if(sha STREQUAL "")
            set(sha "${head}")
        endif()
        if(dirty STREQUAL "" AND NOT describe STREQUAL "")
            if(describe MATCHES "-dirty$")
                set(dirty 1)
            else()
                set(dirty 0)
            endif()
        endif()
    endif()
endif()

foreach(v version sha)
    if(${v} STREQUAL "")
        set(${v} "unknown")
    endif()
endforeach()
if(dirty STREQUAL "1" OR dirty STREQUAL "true")
    set(dirty 1)
elseif(dirty STREQUAL "0" OR dirty STREQUAL "false")
    set(dirty 0)
else()
    set(dirty "unknown")
endif()
if(BUILD_TYPE STREQUAL "")
    set(BUILD_TYPE "none")
endif()

# The CUDA headers parcagpu is built against: CUDA_VERSION (12080 -> 12.8)
# and CUPTI_API_VERSION.
set(cuda_headers "unknown")
set(cupti_api "unknown")
foreach(dir ${CUDA_INCLUDE_DIR})
    if(cuda_headers STREQUAL "unknown" AND EXISTS "${dir}/cuda.h")
        file(STRINGS "${dir}/cuda.h" line REGEX "^#define CUDA_VERSION [0-9]+")
        if(line MATCHES "CUDA_VERSION ([0-9]+)")
            math(EXPR major "${CMAKE_MATCH_1} / 1000")
            math(EXPR minor "${CMAKE_MATCH_1} % 1000 / 10")
            set(cuda_headers "${major}.${minor}")
        endif()
    endif()
    if(cupti_api STREQUAL "unknown" AND EXISTS "${dir}/cupti_version.h")
        file(STRINGS "${dir}/cupti_version.h" line
             REGEX "^#define CUPTI_API_VERSION [0-9]+")
        if(line MATCHES "CUPTI_API_VERSION ([0-9]+)")
            set(cupti_api "${CMAKE_MATCH_1}")
        endif()
    endif()
endforeach()

# The strings go into C string literals and an assembler .asciz.
foreach(v version sha BUILD_TYPE)
    if(NOT "${${v}}" MATCHES "^[A-Za-z0-9._+-]+$")
        message(FATAL_ERROR "parcagpu ${v} '${${v}}': only [A-Za-z0-9._+-] allowed")
    endif()
endforeach()

set(content "// Generated by cmake/version.cmake. Do not edit.
#define PARCAGPU_VERSION \"${version}\"
#define PARCAGPU_GIT_SHA \"${sha}\"
#define PARCAGPU_GIT_DIRTY \"${dirty}\"
#define PARCAGPU_BUILD_TYPE \"${BUILD_TYPE}\"
#define PARCAGPU_CUDA_HEADERS \"${cuda_headers}\"
#define PARCAGPU_CUPTI_API \"${cupti_api}\"
")

if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" old)
else()
    set(old "")
endif()
if(NOT old STREQUAL content)
    file(WRITE "${OUTPUT}" "${content}")
    message(STATUS "parcagpu version: ${version} (sha ${sha}, dirty ${dirty})")
endif()
